# Copy to .env and adjust. docker compose reads this file automatically.

# Host port for the PostgreSQL container. 5433 by default so it never collides
# with a PostgreSQL already installed on the machine.
DB_PORT=5433

# Required in any real deployment: at least 32 bytes.
APP_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
