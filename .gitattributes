# Normalise line endings in the repository; check out native on each platform.
* text=auto

# These run inside Linux containers and must keep LF, whatever the host does.
*.sh      text eol=lf
gradlew   text eol=lf
Dockerfile text eol=lf
*.conf    text eol=lf

# Windows-only launcher.
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

*.jar     binary
*.png     binary
*.jpg     binary
*.webp    binary
*.avif    binary
